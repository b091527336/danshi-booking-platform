APP_NAME="Danshi Booking Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=zh_TW

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

DBP_ADMIN_NAME="DBP 管理者"
DBP_ADMIN_EMAIL=
DBP_ADMIN_PASSWORD=

# Replace these values after TableSit confirms the production OpenAPI contract.
TABLESIT_BASE_URL=
TABLESIT_API_KEY=
TABLESIT_PARTNER_ID=
TABLESIT_AUTH_TYPE=bearer
TABLESIT_AUTH_HEADER=X-API-Key
TABLESIT_BOOKINGS_PATH=/bookings
TABLESIT_ORGANIZATION_PARAMETER=organization_id
TABLESIT_UPDATED_AFTER_PARAMETER=updated_after
TABLESIT_PAGE_PARAMETER=page
TABLESIT_TIMEOUT=15
TABLESIT_MAX_PAGES=100
