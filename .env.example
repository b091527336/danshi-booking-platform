APP_NAME="Danshi Booking Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=zh_TW

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

DBP_ADMIN_NAME="DBP 管理者"
DBP_ADMIN_EMAIL=
DBP_ADMIN_PASSWORD=

TABLESIT_BASE_URL=https://www.tablesit.co/api/v1
# Each tsk_live_ key is bound to one TableSit organization.
# JSON keys must match DBP organization slugs.
TABLESIT_API_KEYS_JSON={"anasa-kaohsiung":"tsk_live_replace_me"}
TABLESIT_TIMEOUT=15
TABLESIT_MAX_PAGES=100
